---
import Layout from '../../layouts/Layout.astro';

const tours = [
  {
    cat: 'Sips + Nibbles',
    name: 'Sip & Nibbles',
    desc: "Downtown Joe's, Palisades, Ristorante Allegria & The Garden. Real nibbles, real pours, real stories.",
    meta: '21+ · 4 stops · 2.5 hrs · max 10 guests · $125/guest',
    href: '/tours/sip-and-nibble',
  },
];
---
<Layout title="Tours" description="Sip & Nibbles: a guided walking tour through downtown Napa. $125/guest, 2.5 hrs, 21+.">
  <section class="page-hero">
    <div class="wrap">
      <div class="eyebrow">The Routes</div>
      <h1>One walk.<br>One downtown.</h1>
      <p class="lead">Every stop is walkable, every stop is vetted, every guide is local.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="tour-grid">
        {tours.map((tour) => (
          <a href={tour.href} class="tour-grid-card is-featured">
            <div class="ticket-cat">{tour.cat}</div>
            <h3>{tour.name}</h3>
            <p>{tour.desc}</p>
            <div class="tour-meta">{tour.meta}</div>
            <div class="card-link">VIEW ROUTE →</div>
          </a>
        ))}
      </div>

    </div>
  </section>
</Layout>
