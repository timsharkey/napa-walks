---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Heritage Walk" description="A downtown Napa history walk. Route and pricing coming soon.">
  <section class="page-hero">
    <div class="wrap">
      <div class="eyebrow">History</div>
      <h1>Heritage Walk</h1>
      <p class="lead">The stories behind downtown Napa's storefronts — architecture, founders, and the buildings that survived.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="tbd-note">
        <span class="mono">ROUTE IN PROGRESS</span>
        Stops, pricing, and duration for Heritage Walk haven't been finalized yet. This page is live so the link works from the tours list and booking form — full route details go here once they're locked.
      </div>
      <div class="cta-block cta-single">
        <div>
          <div class="eyebrow">Want to be first in line?</div>
          <h2>Get notified when it's live</h2>
          <p style="max-width:480px;">Leave your info on the booking form and mention Heritage Walk — we'll reach out the moment dates open up.</p>
          <a href="/#book" class="btn-primary" style="background:var(--stamp); border-color:var(--stamp);">JOIN THE LIST</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
