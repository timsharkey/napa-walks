---
const year = new Date().getFullYear();
---
<footer style="background: var(--color-charcoal); color: #fff; padding: 40px 0; margin-top: 64px;">
  <div class="container" style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px;">
    <div>
      <strong>Napa Walks</strong>
      <p style="margin: 4px 0 0; opacity: 0.7; font-size: 0.9rem;">Guided walking tours in downtown Napa.</p>
    </div>
    <div style="font-size: 0.9rem; opacity: 0.7;">
      &copy; {year} Napa Walks. All rights reserved.
    </div>
  </div>
</footer>
