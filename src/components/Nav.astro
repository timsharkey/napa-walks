---
const links = [
  { href: '/tours', label: 'Tours' },
  { href: '/see-napa', label: 'See Napa' },
  { href: '/about', label: 'About' },
];
---
<nav class="site-nav">
  <div class="wrap">
    <a href="/" class="brand">
      <img src="/assets/brand/napa-walks-logo-wide.png" alt="Napa Walks" width="775" height="494" />
    </a>
    <div class="nav-links">
      {links.map((link) => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
    </div>
    <a href="https://booking.napawalks.com/" class="nav-cta">RESERVE YOUR WALK</a>
  </div>
</nav>
